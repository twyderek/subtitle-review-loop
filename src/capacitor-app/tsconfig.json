{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["../../src/core/*"]
    },
    "types": ["@capacitor/core", "@capacitor/filesystem", "@capacitor/share", "@capacitor/haptics", "@capacitor/app", "@capacitor/preferences", "@capacitor/clipboard", "@capacitor/device", "@capacitor/network", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}