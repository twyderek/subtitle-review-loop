{
  "name": "subtitle-review-native",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Native subtitle review app for iOS/Android - Short video only, Whisper small model",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "ios:build": "node scripts/build-ios.mjs",
    "android:build": "node scripts/build-android.mjs",
    "build:all": "node scripts/build-all.mjs",
    "whisper:build:ios": "bash scripts/build-whisper-ios.sh",
    "whisper:build:android": "bash scripts/build-whisper-android.sh"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@ffmpegkit/ffmpegkit-react-native": "^6.2.0",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "execa": "^9.0.0"
  },
  "capacitor": {
    "plugins": {
      "Whisper": {
        "ios": "WhisperPlugin",
        "android": "WhisperPlugin"
      },
      "FFmpeg": {
        "ios": "FFmpegPlugin",
        "android": "FFmpegPlugin"
      },
      "FileSystemExt": {
        "ios": "FileSystemPlugin",
        "android": "FileSystemPlugin"
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}